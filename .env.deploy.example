COMPOSE_PROJECT_NAME=alex-prod

ALEX_CADDY_IMAGE=caddy:2.10
ALEX_PUBLIC_HOST=api.example.com
ALEX_ACME_EMAIL=ops@example.com
ALEX_PUBLIC_HTTP_PORT=80
ALEX_PUBLIC_HTTPS_PORT=443
ALEX_PROMETHEUS_IMAGE=prom/prometheus:latest
ALEX_PROMETHEUS_PORT=9090
ALEX_PROMETHEUS_RETENTION=15d
ALEX_ALERTMANAGER_IMAGE=prom/alertmanager:latest
ALEX_ALERTMANAGER_PORT=9093
ALEX_ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALEX_GRAFANA_IMAGE=grafana/grafana-oss:latest
ALEX_GRAFANA_PORT=3000
ALEX_GRAFANA_ADMIN_USER=alex
ALEX_GRAFANA_ADMIN_PASSWORD=change-me
ALEX_GRAFANA_ROOT_URL=https://grafana.example.com

ALEX_POSTGRES_DB=alex
ALEX_POSTGRES_USER=alex
ALEX_POSTGRES_PASSWORD=change-me

ALEX_CASSANDRA_KEYSPACE=alex_messenger
ALEX_CASSANDRA_DATACENTER=dc1

ALEX_MINIO_API_PORT=9000
ALEX_MINIO_CONSOLE_PORT=9001
ALEX_MINIO_ROOT_USER=change-me
ALEX_MINIO_ROOT_PASSWORD=change-me
ALEX_S3_BUCKET=alex-media
ALEX_S3_PUBLIC_ENDPOINT=https://files.example.com

ALEX_BACKEND_IMAGE=ghcr.io/your-org/alex-backend:latest
ALEX_BACKEND_PROFILE=docker
ALEX_BACKEND_PORT=8080
ALEX_BACKEND_HEALTHCHECK_URL=http://localhost:8080/actuator/health
ALEX_JWT_SECRET=replace-with-64-byte-secret
ALEX_INTERNAL_SYSTEM_TOKEN=replace-with-internal-system-token
ALEX_LAWFUL_SYSTEM_TOKEN=replace-with-lawful-system-token
ALEX_BOT_WEB_APP_INIT_SECRET=replace-with-bot-web-app-secret
ALEX_COMPLIANCE_EXPORT_ENCRYPTION_SECRET=replace-with-export-encryption-secret
